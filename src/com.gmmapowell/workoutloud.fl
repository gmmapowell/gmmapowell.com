	card WorkOutLoud
		state
			Image background
			Html content

		template workoutloud
			| => 'flas-screensize'
			backdrop <- background
				| => (fillTargetCenter 75 73) 'backdrop'
			article-title <- 'Working Out Loud'
			content <- content
				| => 'workoutloud-content'

		requires Ajax ajax

		implements Lifecycle
			ready
				<- ajax.subscribe (parseUri ("/ajax/workoutloud.html")) AjaxOptions -> UpdateContent
				background <- Image.asset '/images/technology.jpg'

		handler AjaxHandler UpdateContent
			message m
				content <- Html.from m

