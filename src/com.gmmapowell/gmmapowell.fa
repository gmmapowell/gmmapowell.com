	application
		routes
			title "Gareth Powell"
			main <- Root
			home <- Home
			at
				main.nest home
			route "life"
				title "Observations on Life"
				observations <- Observations
				titles <- ArticleList
				enter
					main.nest observations
					titles.load "life"
				at
					observations.nest titles
				route "{articleId}"
					article <- Article
					enter
						article.load "life-"
						article.load articleId
						observations.nest article
			route "now"
				title "Now"
				nowthen <- NowThen
				fromWhen <- Article
				enter
					main.nest nowthen
					nowthen.nest fromWhen
					fromWhen.load "now-when-now"
			route "then"
				title "Then"
				nowthen <- NowThen
				whens <- ArticleList
				enter
					main.nest nowthen
					whens.load "now"
				at
					nowthen.nest whens
				route "{date}"
					fromWhen <- Article
					enter
						nowthen.SetTitle.title date
						fromWhen.load "now-"
						fromWhen.load date
						nowthen.nest fromWhen
//			route "creative"
//				title "Getting Creative"
//				creative <- Creative
//				titles <- ArticleList
//				enter
//					main.nest creative
//					titles.load "creative"
//				at
//					creative.nest titles
//				route "{articleId}"
//					article <- Article
//					enter
//						article.load "creative-"
//						article.load articleId
//						creative.nest article
			route "sports"
				title "Following Sports"
				sports <- Sports
				titles <- ArticleList
				enter
					main.nest sports
					titles.load "sports"
				at
					sports.nest titles
				route "{articleId}"
					article <- Article
					enter
						article.load "sports-"
						article.load articleId
						sports.nest article
			route "politics"
				title "Talking Politics"
				politics <- Politics
				quickFixes <- ArticleList
				musings <- ArticleList
				thoughtExperiments <- ArticleList
				enter
					main.nest politics
					quickFixes.load "politics-quickfixes"
					quickFixes.SetTitle.title "Quick Fixes"
					musings.load "politics-musings"
					musings.SetTitle.title "Musings"
					thoughtExperiments.load "politics-experiments"
					thoughtExperiments.SetTitle.title "Thought Experiments"
				at
					politics.nest quickFixes
					politics.nest musings
					politics.nest thoughtExperiments
				route "{articleId}"
					article <- Article
					enter
						politics.unnest quickFixes
						politics.unnest musings
						politics.unnest thoughtExperiments
						article.load "politics-"
						article.load articleId
						politics.nest article
			route "gallery"
				title "Image Gallery"
				gallery <- Gallery
				enter
					main.nest gallery
			route "technology"
				title "Look at Technology"
				tech <- Technology
				titles <- ArticleList
				enter
					main.nest tech
					titles.load "tech"
				at
					tech.nest titles
				route "{articleId}"
					article <- Article
					enter
						article.load "tech-"
						article.load articleId
						tech.nest article
			route "workoutloud"
				title "Working Out Loud"
				workloud <- WorkOutLoud
				enter
					main.nest workloud
