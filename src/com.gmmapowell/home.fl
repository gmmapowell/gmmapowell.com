	card Home
		state
			Image background

		template home
			| => 'flas-screensize'
			backdrop <- background
				| => (fillTargetCenter 75 73) 'backdrop'
//			creative
//				| => "tile" (minAspect 20 15 15 1 1)
//				=> beCreative
//			creative-text
//				| => 'center-me' (sizeText 25)
			observations
				| => "tile" (minAspect 30 15 15 2 1)
				=> observeLife
			observations-text
				| => 'center-me' (sizeText 25)
			sports
				| => "tile" (minAspect 75 20 15 1 0.7)
				=> playSports
			sports-text
				| => 'center-me' (sizeText 25)
			politics
				| => "tile" (minAspect 15 55 15 1 1)
				=> talkPolitics
			politics-text
				| => 'center-me' (sizeText 25)
			technology
				| => "tile" (minAspect 75 85 15 1.4 0.7)
				=> lookAtTech
			technology-text
				| => 'center-me' (sizeText 25)
			workoutloud
				| => "tile" (minAspect 62 70 19 1.4 0.7)
				=> workoutloud
			workoutloud-text
				| => 'center-me' (sizeText 25)
.			ignorance
.				| => "tile" (minAspect 60 45 22 1.6 0.7)
.				=> ignoranceBlog
.			ignorance-text
.				| => 'center-me' (sizeText 18)
.			now
.				| => "tile" (minAspect 10 15 18 1.4 0.7)
.				=> goNow
.			now-text
.				| => 'center-me' (sizeText 22)
.			go-fish
.				| => "tile" (minAspect 57 15 18 1.4 0.7)
.				=> goFish
.			go-fish-text
.				| => 'center-me' (sizeText 22)
.			downloads
.				| => "tile" (minAspect 33 45 15 1.4 0.7)
.				=> downloads
.			downloads-text
.				| => 'center-me' (sizeText 25)
			gallery
				| => "tile" (minAspect 45 85 15 1.4 1)
				=> gotoGallery
			gallery-text
				| => 'center-me' (sizeText 25)
			organizations
				| => "tile" (minAspect 45 40 15 1.6 0.8)
			organizations-text
				| => 'center-me' (sizeText 30)
			hireme
				| => "tile" (minAspect 80 50 15 1.7 0.8)
				=> jumpToHiring
			hireme-text
				| => 'center-me' (sizeText 30)


		requires Navigation n

		implements Lifecycle
			ready
				background <- Image.asset '/images/hollingworth.jpg'

//		event beCreative (ClickEvent ev)
//			<- n.redirect (parseUri "creative")

		event observeLife (ClickEvent ev)
			<- n.redirect (parseUri "life")

		event playSports (ClickEvent ev)
			<- n.redirect (parseUri "sports")

		event talkPolitics (ClickEvent ev)
			<- n.redirect (parseUri "politics")

		event gotoGallery (ClickEvent ev)
			<- n.redirect (parseUri "gallery")

		event lookAtTech (ClickEvent ev)
			<- n.redirect (parseUri "technology")

		event workoutloud (ClickEvent ev)
			<- n.redirect (parseUri "workoutloud")

		event ignoranceBlog (ClickEvent ev)
			<- n.redirect (parseUri "ignorance-blog")

		event downloads (ClickEvent ev)
			<- n.redirect (parseUri "downloads-page")

		event goNow (ClickEvent ev)
			<- n.redirect (parseUri "now")

		event goFish (ClickEvent ev)
			<- n.redirect (parseUri "go-fish")

		event jumpToHiring (ClickEvent ev)
			<- n.redirect (parseUri "https://hireme.gmmapowell.com")
