	application
		baseuri "https://gmmapowell.com"
//		baseuri 'file:///Users/gareth/Clients/gmmapowell.com/IMAGE/index.html'
		routes
			title "Gareth Powell"
			main <- Root
			home <- Home
			at
				main.nest home
			exit
				main.done
			route "sports"
				title "Following Sports"
				sports <- Sports
				titles <- ArticleList
				enter
					main.nest sports
					titles.load "sports"
				at
					sports.nest titles
				exit
					sports.done
				route "{articleId}"
					articleS <- Article
					enter
						articleS.load "sports-"
						articleS.load articleId
						sports.nest articleS
					exit
						articleS.done
			route "politics"
				title "Talking Politics"
				politics <- Politics
				quickFixes <- ArticleList
				musings <- ArticleList
				thoughtExperiments <- ArticleList
				enter
					main.nest politics
				at
					politics.nest quickFixes
					politics.nest musings
					politics.nest thoughtExperiments
				exit
					politics.done
				route "{articleId}"
					article <- Article
					enter
						politics.unnest quickFixes
						politics.unnest musings
						politics.unnest thoughtExperiments
						article.load "politics-"
						article.load articleId
						politics.nest article
					exit
						article.done
			route "gallery"
				title "Image Gallery"
				gallery <- Gallery
				enter
					main.nest gallery
				exit
					gallery.done
				