	application
		baseuri "https://gmmapowell.com"
		routes
			title "Gareth Powell"
			main <- Root
			home <- Home
			at
				main.nest home
			exit
				main.done
			route "creative"
				title "Getting Creative"
				creative <- Creative
				titlesX <- ArticleList
				enter
					main.nest creative
					titlesX.load "creative"
				at
					creative.nest titlesX
				exit
					creative.done
				route "{articleId}"
					articleC <- Article
					enter
						articleC.load "creative-"
						articleC.load articleId
						creative.nest articleC
					exit
						articleC.done
			route "sports"
				title "Following Sports"
				sports <- Sports
				titles <- ArticleList
				enter
					main.nest sports
					titles.load "sports"
				at
					sports.nest titles
				exit
					sports.done
				route "{articleId}"
					articleS <- Article
					enter
						articleS.load "sports-"
						articleS.load articleId
						sports.nest articleS
					exit
						articleS.done
			route "politics"
				title "Talking Politics"
				politics <- Politics
				quickFixes <- ArticleList
				musings <- ArticleList
				thoughtExperiments <- ArticleList
				enter
					main.nest politics
				at
					politics.nest quickFixes
					politics.nest musings
					politics.nest thoughtExperiments
				exit
					politics.done
				route "{articleId}"
					article <- Article
					enter
						politics.unnest quickFixes
						politics.unnest musings
						politics.unnest thoughtExperiments
						article.load "politics-"
						article.load articleId
						politics.nest article
					exit
						article.done
			route "gallery"
				title "Image Gallery"
				gallery <- Gallery
				enter
					main.nest gallery
				exit
					gallery.done
			route "technology"
				title "Look at Technology"
				tech <- Technology
				tTitles <- ArticleList
				enter
					main.nest tech
					tTitles.load "tech"
				at
					tech.nest tTitles
				exit
					tech.done
				route "{articleId}"
					articleT <- Article
					enter
						articleT.load "tech-"
						articleT.load articleId
						tech.nest articleT
					exit
						articleT.done
