	application
		baseuri "https://gmmapowell.com"
//		baseuri 'file:///Users/gareth/Clients/gmmapowell.com/IMAGE/index.html'
		routes
			title "Gareth Powell"
			main <- Root
			home <- Home
			at
				main.nest home
			exit
				main.done
			route "sports"
				title "Following Sports"
				sports <- Sports
				titles <- ArticleList
				enter
					main.nest sports
					titles.load "sports"
				at
					sports.nest titles
				exit
					sports.done
				route "{articleId}"
//	and now I would like the title set dynamically based on the article
//  can I hand that over to Navigation as well?
					articleS <- Article
					enter
						articleS.load articleId
						sports.nest articleS
					exit
						articleS.done
			route "politics"
				title "Talking Politics"
				politics <- Politics
				enter
					main.nest politics
				exit
					politics.done
				route "{articleId}"
					article <- Article
					enter
						article.load articleId
						politics.nest article
					exit
						article.done
			route "gallery"
				title "Image Gallery"
				gallery <- Gallery
				enter
					main.nest gallery
				exit
					gallery.done
				