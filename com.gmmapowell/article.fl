	card ArticleList
		state
			List[Link] titles

		template article-list
			article-titles <- titles

		template article-title <- (Link l)
			link <- l
				| => 'article-link-style'

		requires Ajax ajax
		implements Lifecycle
			load cat
				<- ajax.subscribe (parseUri ("/ajax/articles.php?cat=" ++ (cast String cat))) AjaxOptions -> UpdateList
		handler AjaxHandler UpdateList
			message m
				titles <- map makeTitle (cast List[Hash] (assoc (parseJson m.body) "articles"))
					makeTitle h = Link (parseUri (cast String (assoc h "id"))) (cast String (assoc h "title"))

	card Article
		state
			String articleId
			Html content

		template article-html
			content <- content
				| => 'text'

		requires Ajax ajax
		implements Lifecycle
			load aid
				articleId <- articleId ++ (cast String aid)
			ready
				<- ajax.subscribe (parseUri ("/ajax/article.php?aid=" ++ articleId)) AjaxOptions -> UpdateContent
		handler AjaxHandler UpdateContent
			message m
				content <- Html.from m
