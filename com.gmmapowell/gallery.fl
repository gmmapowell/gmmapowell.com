	struct DisplayImage
		Number posn
		Image img

	card Gallery
		state
			Image background
			List[DisplayImage] images
			Number selected <- 0

		template gallery
			| => 'flas-screensize'
			backdrop <- background
				| => (fillTargetCenter 75 73) 'backdrop'
			gallery <- images
				| => (promoteBox 1.33 10) 'gallery-image' 'center-me'

		template image <- (DisplayImage d)
			| d.posn <> selected => 'hidden'
			gallery-image <- d.img
				| => (fillRect 15) 'center-me' 'contained-in-box'
			left
				| => 'move-left'
				=> decrement
			right
				| => 'move-right'
				=> increment

		requires Ajax ajax

		implements Lifecycle
			ready
				background <- Image.asset 'images/gallery.png' // should really be a pic of the art gallery
				<- ajax.subscribe (parseUri "https://gmmapowell.com/ajax/gallery.php") AjaxOptions -> UpdateImages

		handler AjaxHandler UpdateImages
			message m
				images <- mapImages 0 (cast List[String] (assoc (parseJson (m.body)) 'images'))
					mapImages n [] = []
					mapImages n (Cons { head: s, tail: l}) = Cons (makeImage n s) (mapImages (n+1) l)
					makeImage n s = DisplayImage n (Image.uri (parseUri s))

		event decrement (ClickEvent e)
			| selected > 0
				selected <- selected - 1
			|
				selected <- length images - 1

		event increment (ClickEvent e)
			| selected < length images - 1
				selected <- selected + 1
			|
				selected <- 0
