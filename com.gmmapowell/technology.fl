	card Technology
		state
			Image background
			Card card

		template technology
			| => 'flas-screensize'
			backdrop <- background
				| => (fillTargetCenter 75 73) 'backdrop'
			article-title <- 'Technology'
			articles <- card

		implements Lifecycle
			nest c
				card <- c
			ready
				background <- Image.asset '/images/boundarypark.jpg'

