	card Observations
		state
			Image background
			Card card

		template observations
			| => 'flas-screensize'
			backdrop <- background
				| => (fillTargetCenter 75 73) 'backdrop'
			article-title <- 'Observations on Life'
			articles <- card

		implements Lifecycle
			nest c
				card <- c
			ready
				background <- Image.asset '/images/rainbow.jpg'