#!/bin/bash -e

cd $HOME/Clients/gmmapowell.com
scripts/publish
rm -rf IMAGE
mkdir IMAGE
mkdir IMAGE/css
cp src/HTACC IMAGE/.htaccess
cp src/icons/favicon.* IMAGE

cp -r src/apps/com.gmmapowell/* IMAGE
cp -r src/ui/images IMAGE
cp -r src/ajax IMAGE
cp -r articles IMAGE
cp -r formatter/wol-html/* IMAGE/ajax

# This overrides the css which should have been copied into the app dir
cp -r src/ui/*.css IMAGE/css
cp custom/fakeit.html IMAGE
cp custom/css/* IMAGE/css
