#!/bin/bash -e

(cd formatter/html ; find * -type f) | sed 's/.html//' | sort > /tmp/all-articles.txt

awk '
  function endit() {
    print "" > ap
    print "<?php" > ap
    print "\t\tbreak;" > ap
  }
  BEGIN {
    ap = "src/ajax/articles.php";
    print "<?php" > ap
	  printf "header(%cAccess-Control-Allow-Origin: *%c);\n", 34, 34 > ap
	  printf "header(%cAccess-Control-Allow-Headers: *%c);\n", 34, 34 > ap
	  print "?>" > ap
	  print "{" > ap
	  printf "\t%carticles%c: [\n", 34, 34 > ap
    print "<?php" > ap
	  printf "\tswitch ($_GET[%ccat%c]) {\n", 39, 39 > ap
	  haveCase = 0
  }
  $0 ~ /^#/ { next }
  $0 ~ /^[ \t]*$/ { next }
  $0 ~ /^[a-z-]*$/ {
  	category = $0;
	  if (haveCase == 1) {
	    endit();
    }
	  haveCase = 1;
    printf "\tcase %c%s%c:\n", 34, category, 34 > ap
	  print "?>" > ap
    needComma = 0;
    prefix = category;
    sub("^[a-z]*", "", prefix);
    if (length(prefix) > 0) {
      prefix = substr(prefix, 2) "-";
    }
	  next;
  }
  $0 ~ /^  / {
  	name=$1;
	  sub("  " name " *", "");
    printf "%s/%s\n", category, name > "/tmp/published-articles.txt"
	  printf "cp %cformatter/html/%s/%s.html%c articles/%s-%s\n", 34, category, name, 34, category, name > "/tmp/publish.sh"
    if (needComma) {
      printf ",\n" > ap
    }
	  printf "\t\t\t{ %cid%c: %c%s%s%c, %ctitle%c: %c%s%c }", 34, 34, 34, prefix, name, 34, 34, 34, 34, $0, 34 > ap
    needComma = 1
  }
  END {
    endit()
	  print "\t}" > ap
	  print "?>" > ap
    print "\t]" > ap
    print "}" > ap
  }
' formatter/publish.txt

echo "Unpublished articles:"
sort /tmp/published-articles.txt | comm -23 /tmp/all-articles.txt - | sed 's/^/ + /'

bash -e /tmp/publish.sh

rm /tmp/publish.sh